---
layout: null
permalink: /feed.xml
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ site.lang }}">
  <title>{{ site.title | xml_escape }}: Blog</title>
  <subtitle>Written guides, cheat sheets and notes from the Mo Chreach! channel.</subtitle>
  <link href="{{ '/feed.xml' | absolute_url }}" rel="self"/>
  <link href="{{ '/blog/' | absolute_url }}"/>
  <id>{{ '/blog/' | absolute_url }}</id>
  <updated>{% if site.posts.size > 0 %}{{ site.posts.first.date | date_to_xmlschema }}{% else %}{{ site.time | date_to_xmlschema }}{% endif %}</updated>
  <author><name>Mo Chreach!</name><email>hello@mochreach.dev</email></author>
  {% for post in site.posts limit: 20 %}
  <entry>
    <title>{{ post.title | xml_escape }}</title>
    <link href="{{ post.url | absolute_url }}"/>
    <id>{{ post.url | absolute_url }}</id>
    <updated>{{ post.date | date_to_xmlschema }}</updated>
    <summary>{{ post.description | default: post.excerpt | strip_html | xml_escape }}</summary>
    <content type="html">{{ post.content | xml_escape }}</content>
  </entry>
  {% endfor %}
</feed>
